function Module.ChangeOverhead(Overhead)
	if not Overhead then
		return
	end

	Overhead.Size = UDim2.fromScale(15, 12)
	Overhead.AlwaysOnTop = true
	Overhead.Brightness = 1
	Overhead.MaxDistance = 1000
	Overhead.StudsOffsetWorldSpace = Vector3.new(0, 0, 0)
	Overhead.StudsOffset = Vector3.new(0, 8, 0)

	for _, UI in ipairs(Overhead:GetDescendants()) do
		if UI:IsA("TextLabel") then
			UI.Size = UDim2.new(0.333, 0, 0.05, 0)
		end
	end

	local User = Overhead:FindFirstChild("User")
	local ETrans = Overhead:FindFirstChild("ETrans")

	if User and User:IsA("TextLabel") then
		User.FontFace = Font.new(
			"rbxasset://fonts/families/Ubuntu.json",
			Enum.FontWeight.Regular,
			Enum.FontStyle.Normal
		)

		User.Size = UDim2.fromScale(1, 0.05)
		User.Position = UDim2.new(0, 0, 0.95, 0)
		User.Text = Overhead.Parent.Parent.Name
	end
	if ETrans and ETrans:IsA("TextLabel") then
		ETrans.Position = UDim2.new(0.05, 0, 0.95, 0)
	end
end

function Module.UpdatePositions(Overhead)
	if not Overhead then
		return
	end

	local GroupStats = {}

	-- Collect visible stats by group
	for StatName, Group in pairs(OverheadGroups) do
		local UI = Overhead:FindFirstChild(StatName)

		if UI and UI:IsA("TextLabel") and UI.Visible then
			GroupStats[Group] = GroupStats[Group] or {}

			table.insert(GroupStats[Group], {
				UI = UI,
				Order = PositionOrder[OverheadUIPos[StatName]]
			})
		end
	end

	-- Position each group separately
	for Group, Stats in pairs(GroupStats) do
		table.sort(Stats, function(A, B)
			return A.Order < B.Order
		end)

		local Count = math.clamp(#Stats, 1, 3)

		for Index, Data in ipairs(Stats) do
			local PositionName

			if Index == 1 then
				PositionName = "First"
			elseif Index == 2 then
				PositionName = "Second"
			else
				PositionName = "Third"
			end

			local X = UISchedule[PositionName][Count]
			local Y = 0.9 - (Group * 0.05)

			Data.UI.Position = UDim2.new(X, 0, Y, 0)
		end
	end
end

function Module.SetupOverhead(Overhead)
	if not Overhead or not Overhead.Parent then
		return
	end

	if Overhead:GetAttribute("OverheadSetup") then
		Module.UpdatePositions(Overhead)
		return
	end

	Overhead:SetAttribute("OverheadSetup", true)

	Module.ChangeOverhead(Overhead)

	local Cash = Overhead:FindFirstChild("Cash")
	local Multi = Overhead:FindFirstChild("Multi")

	if Cash and Cash:IsA("TextLabel") then
		Cash.Visible = true
		Cash.Size = UDim2.new(0.333, 0, 0.05, 0)
		Cash.Position = UDim2.new(
			UISchedule["First"][2],
			0,
			0.9,
			0
		)
	end

	if Multi and Multi:IsA("TextLabel") then
		Multi.Visible = true
		Multi.Size = UDim2.new(0.333, 0, 0.05, 0)
		Multi.Position = UDim2.new(
			UISchedule["Second"][2],
			0,
			0.9,
			0
		)
	end

	Module.UpdatePositions(Overhead)

	for StatName in pairs(OverheadGroups) do
		local UI = Overhead:FindFirstChild(StatName)

		if UI and UI:IsA("TextLabel") then
			UI:GetPropertyChangedSignal("Visible"):Connect(function()
				Module.UpdatePositions(Overhead)
			end)
		end
	end

	Overhead.ChildAdded:Connect(function(UI)
		if not UI:IsA("TextLabel") then
			return
		end

		UI.Size = UDim2.new(0.333, 0, 0.05, 0)

		if OverheadGroups[UI.Name] then
			UI:GetPropertyChangedSignal("Visible"):Connect(function()
				Module.UpdatePositions(Overhead)
			end)
		end

		Module.UpdatePositions(Overhead)
	end)
end

function Module.GetOverhead()

	if not Character then
		return nil
	end

	local Head = Character:FindFirstChild("Head")

	if not Head then
		return nil
	end

	return Head:FindFirstChild("Overhead")
end

function Module.SetupCharacter(Character)
	local Head = Character:WaitForChild("Head", 10)

