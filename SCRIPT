local function TweenPosition(Frame, Pos)
    TweenService:Create(Frame, TweenInfo.new(0.8, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = Pos}):Play()
end

local function UpdateFrameiguess(frame, trigger)
    frame.Visible = trigger
end

function GetFrameInvisibility(frame)
    local pos = frame.Position
	UpdateFrameiguess(frame, pos == UDim2.new(1.5, 0, 0.5, 0) and false or true)

	frame:GetPropertyChangedSignal("Position"):Connect(function()
        pos = frame.Position
	    UpdateFrameiguess(frame, pos == UDim2.new(1.5, 0, 0.5, 0) and false or true)
	end)
end

local function GetFramePosition()
    local Positions = {
		Invisible = UDim2.new(1.5, 0, 0.5, 0),
		Visible = UDim2.new(0.5, 0, 0.5, 0)
	}
	for _, frame in pairs(MainFrames:GetChildren()) do
        if frame.Name ~= "Spectate" then
		    local Status = frame:GetAttribute("Status")
		    TweenPosition(frame, Positions[Status])
			GetFrameInvisibility(frame)

			frame:GetAttributeChangedSignal("Status"):Connect(function()
                Status = frame:GetAttribute("Status")
		        TweenPosition(frame, Positions[Status])
				UpdateFrameiguess(frame)
			end)
		end
	end
end

function Module.SetMainFrame(button, Frame_Name)
    local FrameName = MainFramesName[Frame_Name]
    local LocalFrame = MainFrames:WaitForChild(FrameName)
	LocalFrame:SetAttribute("Status", "Invisible")
	LocalFrame.Position = UDim2.new(1.5,0,0.5,0)
	LocalFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	button.MouseButton1Click:Connect(function()
        local Status = LocalFrame:GetAttribute("Status")

		if Status == "Invisible" then
            LocalFrame:SetAttribute("Status", "Visible")
		elseif Status == "Visible" then
		    LocalFrame:SetAttribute("Status", "Invisible")
		end

		for _, otherFrames in pairs(MainFrames:GetChildren()) do
            if otherFrames ~= LocalFrame and otherFrames.Name ~= "Spectate" then
			    otherFrames:SetAttribute("Status", "Invisible")
			end
		end
	end)
end

function Module.Buttons()
    local Frame = Buttons:FindFirstChild("Frame")
	if not Frame then
        Frame = Instance.new("Frame", Buttons)
	end
	Frame.BackgroundTransparency = 1
	Frame.Position = UDim2.new(0, 20, 0.375, 0)
	Frame.Size = UDim2.fromScale(0.1, 0.2)
	Frame.Visible = true

	GetFramePosition()
	for _, button in pairs(Buttons:GetChildren()) do
		if button ~= Frame then
            button.Parent = Frame
			local TextButton = button:WaitForChild("TextButton")
			local UICornerFrame = Instance.new("UICorner", button)
			local UICornerButton = Instance.new("UICorner", TextButton)
			button.Size = UDim2.new(1, 0, 0.2, 0)
		    if button.Name == "SpectateB" then
                button.Size = UDim2.new(0.75, 0, 0.15, 0)
		    end
			button.BackgroundColor3 = ButtonFrameColors[button.Name]
			button.Position = UDim2.new(0, 0, (ButtonOrders[button.Name] * 0.25) - 0.25, 0)
			local ButtonFrame = Instance.new("Frame", button)
			local UICornerButtonFrame = Instance.new("UICorner", ButtonFrame)
			ButtonFrame.Visible = true
			ButtonFrame.BackgroundColor3 = ButtonTextColors[button.Name]
			ButtonFrame.Position = UDim2.new(0, -3, 0, -3)
			ButtonFrame.Size = UDim2.new(1, 0, 1, 0)

			TextButton.Visible = true
			TextButton.BackgroundColor3 = ButtonTextColors[button.Name]
			TextButton.BackgroundTransparency = 1
			TextButton.ZIndex = 2
			TextButton.TextColor3 = Color3.fromRGB(255,255,255)
			TextButton.Position = UDim2.new(0, -3, 0, -3)
			TextButton.Size = UDim2.new(1, 0, 1, 0)
			if button.Name ~= "SpectateB" then
                Module.SetMainFrame(TextButton, button.Name)
			end
		end
	end
end

